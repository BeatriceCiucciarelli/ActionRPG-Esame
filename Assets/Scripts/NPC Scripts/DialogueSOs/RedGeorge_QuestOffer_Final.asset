  lines:
  - speaker: {fileID: 11400000, guid: 027200893a7ad2841bcef7a53ac0c47b, type: 2}
    text: "You saved my cousin\u2019s village\u2026 but that\u2019s not enough."
  - speaker: {fileID: 11400000, guid: 027200893a7ad2841bcef7a53ac0c47b, type: 2}
    text: "The evil comes from the Black Castle, to the northwest. That\u2019s where
      the Goblin King rules.\n"
  - speaker: {fileID: 11400000, guid: 027200893a7ad2841bcef7a53ac0c47b, type: 2}
    text: Only you can stop him. Go, and free our realm!
